#!/usr/bin/env bash

## Description: Launch an interactive Claude Code session pre-loaded with the /d11-upgrade run skill
## Usage: run-upgrade
## Example: "ddev run-upgrade"

set -uo pipefail

PROJECT_ROOT="${DDEV_APPROOT:-$(pwd)}"
cd "$PROJECT_ROOT" || exit 1

CORE_LOCKED_VERSION="$(grep -A2 '"name": "drupal/core"' composer.lock 2>/dev/null | grep -m1 '"version"' | sed -E 's/.*"version": *"([^"]*)".*/\1/')"
CORE_MAJOR="${CORE_LOCKED_VERSION#v}"; CORE_MAJOR="${CORE_MAJOR%%.*}"
if [ -n "$CORE_MAJOR" ] && [ "$CORE_MAJOR" -ge 11 ] 2>/dev/null; then
  echo "drupal/core is already $CORE_LOCKED_VERSION (D11+) per composer.lock - nothing to upgrade. Not proceeding."
  exit 0
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "claude CLI not found on PATH. Install Claude Code first, then re-run 'ddev run-upgrade'." >&2
  exit 1
fi

exec claude "/d11-upgrade run"
