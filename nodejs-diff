#!/usr/bin/env bash

## Description: Diff two labeled D11 upgrade display-check scraper runs (node diff.js) via yarn
## Usage: nodejs-diff [preLabel] [postLabel]
## Example: "ddev nodejs-diff" or "ddev nodejs-diff pre post"

set -uo pipefail

PROJECT_ROOT="${DDEV_APPROOT:-$(pwd)}"
SCRIPT_DIR="$PROJECT_ROOT/.ddev/commands/host/nodejs"

cd "$SCRIPT_DIR" || exit 1

if ! command -v yarn >/dev/null 2>&1; then
  echo "yarn CLI not found on PATH. Install yarn first, then re-run 'ddev nodejs-diff'." >&2
  exit 1
fi

if [ ! -d node_modules ]; then
  echo "node_modules missing, running 'yarn install' first..." >&2
  yarn install || exit 1
fi

exec yarn diff "$@"
