#!/usr/bin/env bash

## Description: Drupal 10->11 pre-upgrade audit (Drush 13, upgrade_status scan, PHP/DB/module versions, CKEditor 4->5 checklist, stage_file_proxy setup, visual baseline capture) saved to .ddev/commands/host/reports/
## Usage: pre-upgrade
## Example: "ddev pre-upgrade"

set -uo pipefail

PROJECT_ROOT="${DDEV_APPROOT:-$(pwd)}"
cd "$PROJECT_ROOT" || exit 1

REPORTS_DIR="$PROJECT_ROOT/.ddev/commands/host/reports"
mkdir -p "$REPORTS_DIR"

REPORT="$REPORTS_DIR/pre-upgrade.md"
RAW_UPGRADE_STATUS="$REPORTS_DIR/pre-upgrade-upgrade-status-raw.txt"
RAW_WHY_NOT="$REPORTS_DIR/pre-upgrade-composer-why-not-raw.txt"
RAW_DRUPAL_CHECK="$REPORTS_DIR/pre-upgrade-drupal-check-raw.txt"
RAW_NODEJS_SCRAPE="$REPORTS_DIR/pre-upgrade-nodejs-scrape-raw.txt"
CKEDITOR_REPORT="$REPORTS_DIR/ckeditor5-checklist.md"
SCAN_PHP=".ddev/commands/host/pre-upgrade-scan.php"
CKEDITOR_SCAN_PHP=".ddev/commands/host/ckeditor5-checklist-scan.php"

log()  { printf '\033[1;34m==>\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$1"; }

########################################
# Step 0: already on D11?
########################################
CORE_LOCKED_VERSION="$(grep -A2 '"name": "drupal/core"' composer.lock 2>/dev/null | grep -m1 '"version"' | sed -E 's/.*"version": *"([^"]*)".*/\1/')"
CORE_MAJOR="${CORE_LOCKED_VERSION#v}"; CORE_MAJOR="${CORE_MAJOR%%.*}"
if [ -n "$CORE_MAJOR" ] && [ "$CORE_MAJOR" -ge 11 ] 2>/dev/null; then
  log "drupal/core is already $CORE_LOCKED_VERSION (D11+) per composer.lock - nothing to audit. Not proceeding."
  exit 0
fi

########################################
# Step 1: Drush 13
########################################
log "Step 1/8: Drush"
DRUSH_VENDOR="$PROJECT_ROOT/vendor/bin/drush"
if [ ! -f "$DRUSH_VENDOR" ]; then
  log "Drush not found in vendor/. Installing drush/drush:^13 ..."
  ddev composer require drush/drush:^13 --no-interaction
  DRUSH_ACTION="Installed (was missing from vendor)"
else
  log "Drush found. Updating to latest 13.x ..."
  ddev composer update drush/drush --with-all-dependencies --no-interaction
  DRUSH_ACTION="Already present, updated to latest 13.x"
fi
DRUSH_VERSION="$(ddev drush --version 2>/dev/null | tr -d '\r')"
[ -z "$DRUSH_VERSION" ] && DRUSH_VERSION="(unable to determine)"

########################################
# Step 2: upgrade_status module
########################################
log "Step 2/8: upgrade_status module"
if ! grep -q '"drupal/upgrade_status"' composer.json; then
  log "upgrade_status not in composer.json. Installing via ddev composer ..."
  ddev composer require drupal/upgrade_status --dev --no-interaction
  UPGRADE_STATUS_ACTION="Installed (was missing)"
else
  UPGRADE_STATUS_ACTION="Already present in composer.json"
fi

ENABLE_LOG="$(ddev drush en upgrade_status -y 2>&1)"
BOOTSTRAP_OK=true
BOOTSTRAP_ERROR=""
if echo "$ENABLE_LOG" | grep -qiE "AssertionError|terminated abnormally|Drupal is not installed|Unable to bootstrap"; then
  BOOTSTRAP_OK=false
  BOOTSTRAP_ERROR="$(echo "$ENABLE_LOG" | grep -m1 -iE "AssertionError|Drupal is not installed|Unable to bootstrap")"
  warn "Drupal bootstrap failed - upgrade_status:analyze will be skipped. See report for details."
fi

########################################
# Step 3: version scan
########################################
log "Step 3/8: scanning PHP / database / core / tooling versions"

PHP_RUNTIME_VERSION="$(ddev exec php -r 'echo PHP_VERSION;' 2>/dev/null)"
DB_SERVER_VERSION="$(ddev mysql --skip-ssl -N -e 'SELECT VERSION();' 2>/dev/null)"
COMPOSER_VERSION="$(ddev composer --version 2>/dev/null | grep -o 'Composer version [0-9.]*' | awk '{print $3}')"

DDEV_PHP_CFG="$(awk -F'"' '/^php_version:/{print $2}' .ddev/config.yaml)"
DDEV_DB_TYPE="$(awk '/^database:/{f=1;next} f&&/type:/{print $2; exit}' .ddev/config.yaml)"
DDEV_DB_VER="$(awk -F'"' '/^database:/{f=1;next} f&&/version:/{print $2; exit}' .ddev/config.yaml)"

UPGRADE_STATUS_RAN=false
UPGRADE_STATUS_FATAL=""
if $BOOTSTRAP_OK; then
  ddev drush cr >/dev/null 2>&1
  ddev drush upgrade_status:analyze --all 2>&1 | tee "$RAW_UPGRADE_STATUS" >/dev/null
  UPGRADE_STATUS_RAN=true
  if grep -q "PHP Fatal error" "$RAW_UPGRADE_STATUS"; then
    UPGRADE_STATUS_FATAL="$(grep -m1 'PHP Fatal error' "$RAW_UPGRADE_STATUS")"
    warn "upgrade_status:analyze hit a PHP fatal error while scanning - results in the raw report are unreliable. See section 2."
  fi
fi

########################################
# Step 4: module upgrade-path classification (composer.lock + active config, no bootstrap needed)
########################################
log "Step 4/8: classifying module upgrade paths, listing custom modules/themes"
MODULE_REPORT="$(ddev exec php "$SCAN_PHP" 2>&1)"

ddev composer why-not drupal/core 11.0.0 --locked > "$RAW_WHY_NOT" 2>&1
WHY_NOT_CONTRIB="$(grep -E '^drupal/' "$RAW_WHY_NOT" | grep -v '^drupal/core ' || true)"

########################################
# Step 5: deprecated-syntax scan on custom code (mglaman/drupal-check)
########################################
log "Step 5/8: scanning custom modules/themes for deprecated Drupal API usage"
DRUPAL_CHECK_BIN="$PROJECT_ROOT/vendor/bin/drupal-check"
if [ ! -f "$DRUPAL_CHECK_BIN" ]; then
  log "drupal-check not found in vendor/. Installing mglaman/drupal-check via ddev composer ..."
  ddev composer require --dev mglaman/drupal-check --no-interaction
  DRUPAL_CHECK_ACTION="Installed (was missing)"
else
  DRUPAL_CHECK_ACTION="Already present in vendor/ (mglaman/drupal-check, wraps phpstan-drupal)"
fi

DRUPAL_CHECK_TARGETS=()
[ -d web/modules/custom ] && DRUPAL_CHECK_TARGETS+=("web/modules/custom")
[ -d web/themes/custom ] && DRUPAL_CHECK_TARGETS+=("web/themes/custom")

DRUPAL_CHECK_RAN=false
DRUPAL_CHECK_FATAL=""
if [ "${#DRUPAL_CHECK_TARGETS[@]}" -gt 0 ]; then
  ddev exec vendor/bin/drupal-check --deprecations -e "${DRUPAL_CHECK_TARGETS[@]}" 2>&1 | tee "$RAW_DRUPAL_CHECK" >/dev/null
  DRUPAL_CHECK_RAN=true
  if grep -q "PHP Fatal error" "$RAW_DRUPAL_CHECK"; then
    DRUPAL_CHECK_FATAL="$(grep -m1 'PHP Fatal error' "$RAW_DRUPAL_CHECK")"
    warn "drupal-check hit a PHP fatal error while scanning - results are unreliable. See report."
  fi
fi
DRUPAL_CHECK_FINDINGS="$(grep -c ' Line ' "$RAW_DRUPAL_CHECK" 2>/dev/null || echo 0)"

########################################
# Step 6: CKEditor 4 -> 5 migration checklist
########################################
log "Step 6/8: checking CKEditor 4 usage and CKEditor5 plugin compatibility"
CKEDITOR_SCAN_OUTPUT="$(ddev exec php "$CKEDITOR_SCAN_PHP" 2>&1)"
CKEDITOR_STATUS="$(echo "$CKEDITOR_SCAN_OUTPUT" | head -1)"
CKEDITOR_BODY="$(echo "$CKEDITOR_SCAN_OUTPUT" | tail -n +2)"

{
  echo "# CKEditor 4 -> 5 Migration Checklist"
  echo
  echo "_Generated: $(date '+%Y-%m-%d %H:%M:%S %Z')_"
  echo
  echo "$CKEDITOR_BODY"
} > "$CKEDITOR_REPORT"

if [ "$CKEDITOR_STATUS" = "CKEDITOR4: no" ]; then
  log "CKEditor 4 is not in use - nothing to migrate."
elif [ "$CKEDITOR_STATUS" = "CKEDITOR4: yes" ]; then
  warn "CKEditor 4 is in use - see .ddev/commands/host/reports/ckeditor5-checklist.md for plugin compatibility."
else
  warn "Could not determine CKEditor version (unexpected scan output). See .ddev/commands/host/reports/ckeditor5-checklist.md."
fi

########################################
# Step 7: stage_file_proxy (proxy missing local files from BASE_URL in .env)
########################################
log "Step 7/8: installing/configuring stage_file_proxy"

ENV_FILE="$PROJECT_ROOT/.ddev/commands/host/.env"
STAGE_FILE_PROXY_ORIGIN=""
if [ -f "$ENV_FILE" ]; then
  STAGE_FILE_PROXY_ORIGIN="$(grep -E '^BASE_URL=' "$ENV_FILE" | tail -1 | cut -d= -f2-)"
fi

if ! grep -q '"drupal/stage_file_proxy"' composer.json; then
  log "stage_file_proxy not in composer.json. Installing via ddev composer ..."
  ddev composer require drupal/stage_file_proxy --no-interaction
  STAGE_FILE_PROXY_ACTION="Installed (was missing)"
else
  STAGE_FILE_PROXY_ACTION="Already present in composer.json"
fi

STAGE_FILE_PROXY_ENABLED=false
STAGE_FILE_PROXY_CONFIGURED=false
if $BOOTSTRAP_OK; then
  ddev drush en stage_file_proxy -y >/dev/null 2>&1 && STAGE_FILE_PROXY_ENABLED=true
  if $STAGE_FILE_PROXY_ENABLED; then
    if [ -n "$STAGE_FILE_PROXY_ORIGIN" ]; then
      ddev drush config:set stage_file_proxy.settings origin "$STAGE_FILE_PROXY_ORIGIN" -y >/dev/null 2>&1 && STAGE_FILE_PROXY_CONFIGURED=true
    else
      warn "No BASE_URL found in .ddev/commands/host/.env - skipping stage_file_proxy origin config."
    fi
  else
    warn "Could not enable stage_file_proxy via drush."
  fi
else
  warn "Drupal bootstrap is broken - skipping stage_file_proxy enable/configure."
fi

########################################
# Step 8: capture pre-upgrade visual baseline (nodejs-scrape)
########################################
log "Step 8/8: capturing pre-upgrade visual baseline (ddev nodejs-scrape pre)"

NODEJS_SCRAPE_CMD="$PROJECT_ROOT/.ddev/commands/host/nodejs-scrape"
NODEJS_SCRAPE_RAN=false
NODEJS_SCRAPE_STATUS=""
if [ -x "$NODEJS_SCRAPE_CMD" ]; then
  if ddev nodejs-scrape pre 2>&1 | tee "$RAW_NODEJS_SCRAPE"; then
    NODEJS_SCRAPE_RAN=true
    NODEJS_SCRAPE_STATUS="Captured pre-upgrade snapshot(s) to \`.ddev/commands/host/nodejs/output/pre.*.json\`"
  else
    NODEJS_SCRAPE_STATUS="**FAILED** - see \`.ddev/commands/host/reports/pre-upgrade-nodejs-scrape-raw.txt\`"
    warn "ddev nodejs-scrape pre failed - see .ddev/commands/host/reports/pre-upgrade-nodejs-scrape-raw.txt"
  fi
else
  NODEJS_SCRAPE_STATUS="**skipped** - \`.ddev/commands/host/nodejs-scrape\` not installed. Run \`./drupal-scripts/setup-drupal-upgrade.sh\` first, then re-run \`ddev pre-upgrade\`."
  warn "nodejs-scrape not installed - skipping visual baseline capture."
fi

########################################
# Write report
########################################
log "Writing report to .ddev/commands/host/reports/pre-upgrade.md"

{
  echo "# Drupal 10 -> 11 Pre-Upgrade Audit"
  echo
  echo "_Generated: $(date '+%Y-%m-%d %H:%M:%S %Z')_"
  echo
  echo "## 1. Drush"
  echo
  echo "- Action: $DRUSH_ACTION"
  echo "- Version: \`$DRUSH_VERSION\`"
  echo "- D11 requirement: Drush 13"
  echo
  echo "## 2. upgrade_status module"
  echo
  echo "- Action: $UPGRADE_STATUS_ACTION"
  if $BOOTSTRAP_OK; then
    echo "- Enabled: yes"
  else
    echo "- Enabled: **FAILED - Drupal bootstrap is broken**"
    echo "- Error: \`$BOOTSTRAP_ERROR\`"
    echo "- This blocks \`drush upgrade_status:analyze\` and most other drush commands that require a full bootstrap. See the orphan module list in section 4 - this is almost certainly the cause. Fix that first, then re-run \`ddev pre-upgrade\`."
  fi
  if $UPGRADE_STATUS_RAN; then
    echo "- Full scan output: \`.ddev/commands/host/reports/pre-upgrade-upgrade-status-raw.txt\`"
  fi
  if [ -n "$UPGRADE_STATUS_FATAL" ]; then
    echo "- **Scan unreliable:** the analyzer hit a PHP fatal error while bootstrapping code for (likely) every module, so most per-module results in the raw report are this same fatal, not real deprecation findings. Fix the fatal, then re-run \`ddev pre-upgrade\`."
    echo "- Fatal error: \`$UPGRADE_STATUS_FATAL\`"
  fi
  echo
  echo "## 3. Environment / tooling versions"
  echo
  echo "| Component | Detected | D11 requirement | Status |"
  echo "|---|---|---|---|"
  echo "| PHP (running) | ${PHP_RUNTIME_VERSION:-unknown} | 8.3 min, 8.4 recommended | $( [ -n "$PHP_RUNTIME_VERSION" ] && php_status=$(printf '%s\n8.3\n' "$PHP_RUNTIME_VERSION" | sort -V | head -1) && ([ "$php_status" = "8.3" ] && echo "OK" || echo "BELOW MINIMUM") || echo "unknown" ) |"
  echo "| PHP (.ddev/config.yaml) | ${DDEV_PHP_CFG:-unknown} | 8.3 min, 8.4 recommended | - |"
  echo "| Database server (running) | ${DDEV_DB_TYPE:-unknown} ${DB_SERVER_VERSION:-unknown} | MariaDB 10.6+ / MySQL 8.0+ | $( [ -n "$DB_SERVER_VERSION" ] && db_status=$(printf '%s\n10.6\n' "$DB_SERVER_VERSION" | sort -V | head -1) && ([ "$db_status" = "10.6" ] && echo "OK" || echo "BELOW MINIMUM") || echo "unknown" ) |"
  echo "| Database (.ddev/config.yaml) | ${DDEV_DB_TYPE:-unknown} ${DDEV_DB_VER:-unknown} | MariaDB 10.6+ / MySQL 8.0+ | - |"
  echo "| Drupal core (composer.lock) | ${CORE_LOCKED_VERSION:-unknown} | ^11.0 | still on D10 |"
  echo "| Drush | $DRUSH_VERSION | ^13 | see section 1 |"
  echo "| Composer | ${COMPOSER_VERSION:-unknown} | 2.x | OK |"
  echo
  if [ -n "$DB_SERVER_VERSION" ]; then
    echo "**Note:** the \`mysql\`/\`mariadb\` CLI in the web container may negotiate TLS by default against an older DB server and fail with \`TLS/SSL error\`. Use \`ddev mysql --skip-ssl\` (or add \`--skip-ssl\` to any raw \`mysql\`/\`drush sql:query\` call) when the server is still on MariaDB 10.4."
    echo
  fi
  echo "## 4. Module upgrade paths"
  echo
  echo "$MODULE_REPORT"
  echo "### Composer-level blockers (\`composer why-not drupal/core 11.0.0\`)"
  echo
  if [ -n "$WHY_NOT_CONTRIB" ]; then
    echo '```'
    echo "$WHY_NOT_CONTRIB"
    echo '```'
    echo
    echo "Full output (includes root/core dependency chain noise): \`.ddev/commands/host/reports/pre-upgrade-composer-why-not-raw.txt\`"
  else
    echo "_No contrib package directly blocks drupal/core 11.0.0 per \`composer.lock\`._"
  fi
  echo
  echo "## 5. Deprecated syntax scan on custom code (mglaman/drupal-check)"
  echo
  echo "- Action: $DRUPAL_CHECK_ACTION"
  if [ "${#DRUPAL_CHECK_TARGETS[@]}" -gt 0 ]; then
    echo "- Scanned: $(IFS=', ' ; echo "${DRUPAL_CHECK_TARGETS[*]}")"
  else
    echo "- Scanned: **skipped - neither web/modules/custom nor web/themes/custom exist**"
  fi
  if $DRUPAL_CHECK_RAN; then
    echo "- Full scan output: \`.ddev/commands/host/reports/pre-upgrade-drupal-check-raw.txt\`"
    if [ -n "$DRUPAL_CHECK_FATAL" ]; then
      echo "- **Scan unreliable:** hit a PHP fatal error while bootstrapping code (this happens regardless of which module/theme is targeted, since Drupal loads every enabled theme's \`.theme\` file). Fix the fatal, then re-run \`ddev pre-upgrade\`."
      echo "- Fatal error: \`$DRUPAL_CHECK_FATAL\`"
    else
      echo "- Deprecation findings: $DRUPAL_CHECK_FINDINGS (see raw output for file/line detail)"
    fi
  fi
  echo
  echo "## 6. CKEditor 4 -> 5 migration checklist"
  echo
  if [ "$CKEDITOR_STATUS" = "CKEDITOR4: no" ]; then
    echo "- CKEditor 4 in use: no - nothing to migrate."
  elif [ "$CKEDITOR_STATUS" = "CKEDITOR4: yes" ]; then
    echo "- CKEditor 4 in use: **yes** - plugin compatibility details below."
  else
    echo "- CKEditor 4 in use: **unknown - scan output was not in the expected format**"
  fi
  echo "- Full checklist: \`.ddev/commands/host/reports/ckeditor5-checklist.md\`"
  echo
  echo "## 7. stage_file_proxy"
  echo
  echo "- Action: $STAGE_FILE_PROXY_ACTION"
  if $STAGE_FILE_PROXY_ENABLED; then
    echo "- Enabled: yes"
  else
    echo "- Enabled: **no** (see warnings above)"
  fi
  if $STAGE_FILE_PROXY_CONFIGURED; then
    echo "- Origin: \`$STAGE_FILE_PROXY_ORIGIN\` (from \`.ddev/commands/host/.env\`)"
  elif [ -n "$STAGE_FILE_PROXY_ORIGIN" ]; then
    echo "- Origin: **not set** - \`$STAGE_FILE_PROXY_ORIGIN\` found in \`.env\` but \`config:set\` failed or was skipped"
  else
    echo "- Origin: **not set** - no \`BASE_URL\` in \`.ddev/commands/host/.env\`. Run \`./drupal-scripts/setup-drupal-upgrade.sh\` to be prompted for the site domain, then re-run \`ddev pre-upgrade\`."
  fi
  echo
  echo "## 8. Visual baseline (nodejs-scrape)"
  echo
  echo "- $NODEJS_SCRAPE_STATUS"
  if $NODEJS_SCRAPE_RAN; then
    echo "- Full scrape output: \`.ddev/commands/host/reports/pre-upgrade-nodejs-scrape-raw.txt\`"
    echo "- After the upgrade, run \`ddev nodejs-scrape post\` then \`ddev nodejs-diff\` to diff against this baseline."
  fi
  echo
} > "$REPORT"

log "Done. Report: .ddev/commands/host/reports/pre-upgrade.md"
if ! $BOOTSTRAP_OK; then
  warn "Drupal bootstrap is currently broken (see section 2 of the report) - fix that blocker and re-run 'ddev pre-upgrade' to get the full upgrade_status scan."
fi
